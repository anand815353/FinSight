APP__NAME=FinSight
APP__ENV=local
APP__DEBUG=false
# Use at least 32 chars in production.
APP__SECRET_KEY=change-me-local-32-plus-characters

LOGGING__LEVEL=INFO
LOGGING__JSON_LOGS=true

# Runtime profile (explicit; auto infers from dependency URLs below)
RUNTIME__PROFILE=host
RUNTIME__STRICT_PROFILE_VALIDATION=true

# Feature placeholders (MVP: all disabled; no product features wired yet)
FEATURES__ENABLE_RAG=false
FEATURES__ENABLE_INGESTION=false
FEATURES__ENABLE_RED_FLAG_SCANNER=false
FEATURES__ENABLE_EXPORTS=false

# --- Dependency URLs: pick ONE profile ---
#
# Rule: uvicorn on your machine (PyCharm / uv run) -> Profile B (active below).
#       uvicorn inside `docker compose` web/worker -> Profile A (comment B, uncomment A).
#
# Published ports from Docker Desktop map to 127.0.0.1 on the host.
# QDRANT__API_KEY is not required for local qdrant/qdrant containers.

# B) Host dev (PyCharm + Docker Desktop on published ports) — DEFAULT
MONGODB__URI=mongodb://127.0.0.1:27017
REDIS__URL=redis://127.0.0.1:6379/0
QDRANT__URL=http://127.0.0.1:6333
QDRANT__API_KEY=
CELERY__BROKER_URL=redis://127.0.0.1:6379/1
CELERY__RESULT_BACKEND=redis://127.0.0.1:6379/2

# A) Compose / in-container (docker compose up web)
# MONGODB__URI=mongodb://mongodb:27017
# REDIS__URL=redis://redis:6379/0
# QDRANT__URL=http://qdrant:6333
# QDRANT__API_KEY=
# CELERY__BROKER_URL=redis://redis:6379/1
# CELERY__RESULT_BACKEND=redis://redis:6379/2

MONGODB__DB_NAME=finsight

SESSION__COOKIE_NAME=finsight_session
SESSION__COOKIE_SECURE=false
SESSION__COOKIE_HTTP_ONLY=true
SESSION__COOKIE_SAME_SITE=lax
SESSION__ACCESS_TOKEN_EXPIRE_MINUTES=480
SESSION__CSRF_COOKIE_NAME=finsight_csrf

LLM__PROVIDER=gemini
LLM__MODEL_NAME=placeholder-model
LLM__API_KEY=

EMBEDDING__COLLECTION_NAME=finsight_chunks_gemini_v1
EMBEDDING__MODEL_VERSION=v1

USAGE__FREE_DAILY_QUESTION_LIMIT=3
USAGE__BETA_DAILY_QUESTION_LIMIT=5
USAGE__MONTHLY_BUDGET_INR=5000

STORAGE__DOCUMENT_STORAGE_PATH=data/filings
